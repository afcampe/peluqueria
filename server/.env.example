# --- General ---
PORT=4000
# Orígenes permitidos (web, Capacitor, Electron). Separados por comas.
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,http://localhost
JWT_SECRET=cambia-esto-por-un-secreto-largo
DATABASE_URL="file:./dev.db"

# Administrador inicial (lo crea el seed)
ADMIN_EMAIL=admin@peluqueriaarmando.es
ADMIN_PASSWORD=admin1234

# --- PayPal (https://developer.paypal.com) ---
# PAYPAL_MODE=sandbox | live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Email (SMTP). Si se deja vacío, los emails se muestran en consola ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Peluquería Armando <no-reply@peluqueriaarmando.es>"

# --- WhatsApp Cloud API (opcional). Sin esto se usan enlaces wa.me ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
