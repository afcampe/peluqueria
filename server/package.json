    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/luxon": "3.4.2",
    "@types/node": "22.10.2",
    "@types/nodemailer": "6.4.17",
    "prisma": "6.19.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
