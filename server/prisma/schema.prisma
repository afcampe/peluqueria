// SQLite para desarrollo. Para producción cambia provider a "postgresql"
// y DATABASE_URL a tu servidor Postgres; el resto del esquema es compatible.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  // Las fichas creadas al importar la agenda en papel no tienen email ni
  // contraseña (cliente sin cuenta) hasta que se les crea el acceso.
  email        String?       @unique
  passwordHash String?
  name         String
  phone        String?
  role         String        @default("CLIENT") // CLIENT | ADMIN
  status       String        @default("ACTIVE") // ACTIVE | BLOCKED | DELETED
  blockedUntil DateTime? // null + BLOCKED = bloqueo indefinido
  blockReason  String?
  acceptsEmail Boolean       @default(true)
  // Novedades por WhatsApp: solo si lo aceptó con la casilla que lo incluye.
  acceptsWhatsapp Boolean    @default(false)
  // Recordatorios de citas que quiere recibir. Solo cuentan si el canal está
  // activado en Configuración; al desactivarlo allí se apagan en todos.
  remindEmail    Boolean     @default(true)
  remindWhatsapp Boolean     @default(true)
  // Foto de perfil (JPEG/PNG/WebP reducida en el cliente, máx. 300 KB)
  avatar          Bytes?
  avatarMime      String?
  avatarUpdatedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  waitlist     WaitlistEntry[]
  series       AppointmentSeries[]
  tickets      Ticket[]
}

// Citas periódicas (p. ej. cada 15 días) reservadas de una sola vez.
model AppointmentSeries {
  id           String        @id @default(cuid())
  clientId     String
  client       User          @relation(fields: [clientId], references: [id])
  intervalDays Int
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

model Service {
  id           String        @id @default(cuid())
  name         String
  priceCents   Int
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  appointments Appointment[]
}

model Appointment {
  id            String    @id @default(cuid())
  clientId      String
  client        User      @relation(fields: [clientId], references: [id])
  serviceId     String
  service       Service   @relation(fields: [serviceId], references: [id])
  seriesId      String?
  series        AppointmentSeries? @relation(fields: [seriesId], references: [id])
  startAt       DateTime
  endAt         DateTime
  // PENDING_PAYMENT | CONFIRMED | CANCELLED | COMPLETED | NO_SHOW
  status        String    @default("CONFIRMED")
  paymentMethod String // id del proveedor: "cash", "paypal", ...
  priceCents    Int
  notes         String?
  holdExpiresAt DateTime? // reserva temporal mientras se paga online
  cancelledAt   DateTime?
  cancelledBy   String? // CLIENT | ADMIN | SYSTEM
  cancelReason  String?
  // Asistencia confirmada por el cliente: null (sin respuesta) | YES | NO
  attendance    String?
  attendanceAt  DateTime?
  attendanceBy  String? // EMAIL | WHATSAPP | ADMIN
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]
  reminders     AppointmentReminder[]

  @@index([startAt])
  @@index([clientId])
  @@index([seriesId])
}

model Payment {
  id                String      @id @default(cuid())
  appointmentId     String
  appointment       Appointment @relation(fields: [appointmentId], references: [id])
  provider          String
  providerOrderId   String?
  providerCaptureId String?
  // Datos del pagador en la plataforma (PayPal), para saber a quién se reembolsa
  payerEmail        String?
  payerId           String?
  capturedAt        DateTime?
  amountCents       Int
  currency          String      @default("EUR")
  // CREATED | COMPLETED | PARTIALLY_REFUNDED | REFUNDED | FAILED
  status            String      @default("CREATED")
  refundedCents     Int         @default(0)
  ticketId          String?
  ticket            Ticket?     @relation(fields: [ticketId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  refunds           Refund[]

  @@index([ticketId])
}

// Ticket de compra. Numeración AAAA-NNNN única y consecutiva para todos los
// métodos de pago (se reinicia cada año). El PDF se guarda en disco, en
// TICKETS_DIR/AAAA/MM/, no en la base de datos.
model Ticket {
  id         String    @id @default(cuid())
  number     String    @unique // p. ej. 2026-0001
  year       Int
  seq        Int
  issuedAt   DateTime  @default(now())
  clientId   String
  client     User      @relation(fields: [clientId], references: [id])
  provider   String // cash, paypal...
  origin     String // SHOP (emitido en la peluquería) | ONLINE (pago del cliente)
  totalCents Int
  vatPercent Float? // IVA al emitirlo (null solo en tickets antiguos, se rellena al arrancar)
  currency   String    @default("EUR")
  filePath   String // relativa a TICKETS_DIR: 2026/11/2026-0001.pdf
  payments   Payment[]
  rectifications Rectification[]

  @@unique([year, seq])
  @@index([clientId])
}

// Ticket rectificativo: se emite al devolver (todo o parte de) un cobro con ticket.
// Serie propia RAAAA-NNNN, consecutiva por año. El ticket original no se modifica.
model Rectification {
  id          String   @id @default(cuid())
  number      String   @unique // p. ej. R2026-0001
  year        Int
  seq         Int
  issuedAt    DateTime @default(now())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  refundId    String   @unique
  refund      Refund   @relation(fields: [refundId], references: [id])
  amountCents Int // importe devuelto (en positivo)
  reason      String
  filePath    String // relativa a TICKETS_DIR: 2026/11/R2026-0001.pdf

  @@unique([year, seq])
  @@index([ticketId])
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id])
  amountCents      Int
  providerRefundId String?
  reason           String?
  requestedBy      String // CLIENT | ADMIN | SYSTEM
  createdAt        DateTime @default(now())
  rectification    Rectification?
}

// Cierres temporales (vacaciones, festivos, bajas...). Bloquean huecos.
model Closure {
  id        String   @id @default(cuid())
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())
}

// Configuración de negocio en formato clave -> JSON
model Setting {
  key   String @id
  value String
}

model MessageLog {
  id         String   @id @default(cuid())
  channel    String // EMAIL | WHATSAPP
  subject    String?
  body       String
  recipients Int
  sentBy     String?
  createdAt  DateTime @default(now())
}

// Página de la agenda en papel fotografiada para importar sus citas.
// La foto se guarda en IMPORT_DIR solo hasta que se importa o se descarta.
model AgendaImport {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // PENDING (en cola) | READING | READY (para revisar) | ERROR | IMPORTED | DISCARDED
  status        String    @default("PENDING")
  fileName      String?
  imagePath     String? // relativa a IMPORT_DIR; null tras importar o descartar
  imageMime     String?
  error         String?
  rows          String    @default("[]") // JSON: ImportRow[]
  importedCount Int       @default(0)
  importedAt    DateTime?
  createdBy     String?
}

// Recordatorio automático enviado (o intentado) antes de una cita.
// Uno por cita, hora de la cita, antelación y canal: así nunca se repite,
// y si la cita cambia de hora se vuelve a avisar.
model AppointmentReminder {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  startAt       DateTime // hora de la cita cuando se avisó
  offsetMinutes Int
  channel       String // EMAIL | WHATSAPP
  status        String // SENDING | SENT | FAILED | SKIPPED
  detail        String? // motivo del fallo o de que no se enviara
  createdAt     DateTime    @default(now())

  @@unique([appointmentId, startAt, offsetMinutes, channel])
  @@index([createdAt])
}

// Lista de espera de un día completo. La lleva el administrador.
model WaitlistEntry {
  id         String    @id @default(cuid())
  clientId   String
  client     User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date       String // YYYY-MM-DD, en la zona de la peluquería
  part       String    @default("ANY") // ANY | MORNING | AFTERNOON
  notes      String?
  status     String    @default("WAITING") // WAITING | BOOKED | CANCELLED | EXPIRED
  notifiedAt DateTime? // avisado de que hay hueco (null si se ha vuelto a llenar)
  createdBy  String?
  createdAt  DateTime  @default(now())

  @@index([status, date])
}
